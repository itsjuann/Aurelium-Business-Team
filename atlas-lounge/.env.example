# The Atlas Lounge · environment variables
# Copy to .env.local for development. Never commit real values.
# "Public" variables (NEXT_PUBLIC_*) are sent to the browser; everything else is server-only.

# ── Site (Phase 1) ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business details. Leave blank until confirmed: the site simply omits anything unset.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SERVICE_AREA=
NEXT_PUBLIC_INSTAGRAM_URL=

# Set to "true" only after legal counsel has approved the Privacy Policy and Terms.
NEXT_PUBLIC_LEGAL_REVIEWED=false

# ── Booking gate (Phase 1) ───────────────────────────────────────────────────────
# Comma-separated slugs of licence-gated services whose practitioner credentials the owner
# has verified (e.g. "massage"). While empty, those services cannot be requested and the
# Book page collects interest only. Replaced by database-driven eligibility in Phase 3.
CREDENTIAL_VERIFIED_SERVICES=

# Design review only: shows draft services/packages with a "Draft" badge. Ignored on the
# Vercel production deployment. Never purchasable either way.
CATALOG_PREVIEW_DRAFTS=false

# ── Supabase (Phase 1: stores waitlist, contact and booking-request submissions) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # used from Phase 2 (auth)
SUPABASE_SERVICE_ROLE_KEY=            # server-only; bypasses RLS. Never expose to the browser.

# ── Stripe (Phase 4, test mode first) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Resend (Phase 7) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Twilio, optional SMS (Phase 7) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ── AI features, optional and off by default (Phase 8) ───────────────────────────
ANTHROPIC_API_KEY=

# ── Tests ────────────────────────────────────────────────────────────────────────
# PostgreSQL superuser URL for `npm run test:db` (a throwaway database is created and dropped).
TEST_DATABASE_URL=
