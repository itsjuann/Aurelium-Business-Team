# Aurelium Motion — secrets inventory. Copy to .env and fill in. NEVER commit .env.
# Each key: owner = Juan, rotate on leak immediately, review quarterly.

# ElevenLabs Agents (receptionist platform). Scope: agents + conversations only.
ELEVENLABS_API_KEY=

# Telephony for client numbers (if Twilio is used instead of ElevenLabs-native numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Cold-email sending tool (Instantly / Smartlead) — secondary domain only
COLD_EMAIL_API_KEY=

# Lead notification (SMS/email to clients and Juan)
NOTIFY_SMS_PROVIDER_KEY=

# Hosting
VERCEL_TOKEN=
RENDER_API_KEY=

# Social scheduling
BUFFER_ACCESS_TOKEN=

# Anthropic (for any in-house automation)
ANTHROPIC_API_KEY=

# save_lead webhook shared secret (HMAC). Lives in the ElevenLabs tool secret store + the endpoint's env. Never in a prompt.
SAVE_LEAD_WEBHOOK_SECRET=
# GitHub fine-grained token, this repo only (contents + pull requests). Prefer the connector; set only if a script needs it.
GITHUB_TOKEN=
# Demo CRM access key for apps/hvac-demo (32+ characters, different from the webhook secret). Lives in the host's env only.
DEMO_CRM_VIEW_KEY=
