# Required in production
NODE_ENV=production
ADMIN_PASSWORD=change-me
SESSION_SECRET=long-random-string
BASE_URL=https://guests.yourdomain.com   # printed inside every QR code

# Optional
PORT=3000
DB_PATH=data/app.db
DEFAULT_COUNTRY_CODE=1

# SMS (Twilio). Leave blank to simulate: messages are logged, nothing is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=   # or set TWILIO_FROM=+1...
TWILIO_FROM=

# Email (Resend). Leave blank to simulate.
RESEND_API_KEY=
EMAIL_FROM=rewards@yourdomain.com
